<!--
Create a simulation with some duration (months), start month, start year, and decay type (never, manual, lazy)

# Cyclus can operate in 3 decay modes, with 1 additional mode likely to be added in a future release:

# never, all decay is turned off
# manual, meaning it is only on if the individual archetype decays their own inventory
# lazy, which will compute decay only when archetypes fetch a particular composition.

# never is often used because the half-lives of the uranium, plutonium, and caesium isotopes are usually much longer than the simulation
# 137Cs is shortest (~30 years), so thats the one to watch for to decide if you want to include decay or not -->

<simulation>
    <control>
        <duration>720</duration>
        <startmonth>1</startmonth>
        <startyear>2018</startmonth>
        <decay>never</decay>
    </control>
</simulation>

<!--
# Determine types of archetypes, aka types of facilities in the fuel cycle
# Source: like a mine
# Enrichment: tf you think it is
# Reactor: fresh and used fuel into more used fuel with composition indicative of more burnup
# Sink: like a waste repository -->
<archetypes>
    <spec>
        <lib>cycamore</lib>
        <name>Source</name>
    </spec>
    <spec>
        <lib>cycamore</lib>
        <name>Enrichment</name>
    </spec>
    <spec>
        <lib>cycamore</lib>
        <name>Reactor</name>
    </spec>
    <spec>
        <lib>cycamore</lib>
        <name>Sink</name>
    </spec>
</archetypes>

<!--
# Commodities: complex system that allows facilities to trade with each other, make and accept bids, and use different suppliers 
# Usually a commodity is a material produced by a facility, so we define our materials once so we don't have to repeatedly say what used fuel is made of

# Basis: mass or atom
# id: nuclide in the form ZZAAA, or by name like U235 or U-235

# natural uranium (from source into enrichment, these aren't CANDU or IPHWR) -->
<recipe>
    <name>nat_u</name>
    <basis>mass</basis>
    <nuclide>
        <id>92235</id>
        <comp>0.00711</comp>
    </nuclide>
    <nuclide>
        <id>92238</id>
        <comp>0.99289</comp>
    </nuclide>
</recipe>

<!-- fresh fuel, we aren't reprocessing in this example so it's all just UOX instead of MOX -->
<recipe>
    <name>fresh_uox</name>
    <basis>mass</basis>
    <nuclide>
        <id>92235</id>
        <comp>0.04</comp>
    </nuclide>
    <nuclide>
        <id>92238</id>
        <comp>0.96</comp>
    </nuclide>
</recipe>

<!-- used fuel, only fission product that we're modeling is 137Cs because this is a simple model. We're also not modeling higher plutonia above 239 because idfc -->
<recipe>
    <name>spent_uox</name>
    <basis>mass</basis>
    <nuclide>
        <id>92235</id>
        <comp>0.011</comp>
    </nuclide>
    <nuclide>
        <id>92238</id>
        <comp>0.94</comp>
    </nuclide>
    <nuclide>
        <id>94239</id>
        <comp>0.009</comp>
    </nuclide>
    <nuclide>
        <id>55137</id>
        <comp>0.04</comp>
    </nuclide>
</recipe>

