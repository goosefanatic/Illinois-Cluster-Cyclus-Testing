    <facility>
        <name>us_inventory</name>
        <config>
        <us_inventory>
            <selection_policy>highest_minor_actinide</selection_policy>
            <outcommod>spent_fuel</outcommod>
            <data_dir>./assembly_data/</data_dir>
        </us_inventory>
        </config>
    </facility>


    <facility>
        <name>Final_Disposal</name>
        <config>
        <Sink>
            <in_commods>
            <val>separated_waste</val>
            </in_commods>
            <capacity>10000</capacity>
        </Sink>
        </config>
    </facility>

    <facility>
        <name>NATURE_Reactor</name>
        <config>
        <ads>
            <in_commods>
            <val>mixed_actinides</val> 
            </in_commods>
            <outcommod>
            <val>ads_burnt_fuel</val> <!-- should output interpolated STANDARDS to Serpent files -->
            </outcommod>
        </ads>
        </config>
    </facility>

    <!-- Mix actinides to send to ADS -->
    <facility>
        <name>Mixer_facility</name>
        <config>
            <Mixer>
                <in_commods>
                    <val>separated_actinides</val>
                </in_commods>
                <outcommod>
                    <val>mixed_actinides</val>
                </outcommod>
            </Mixer>
        <config>
    </facility>


    <facility>
        <name>SeparationsFacility</name>
        <config>
            <Separations>
                <feed_commods> 
                    <val>ads_burnt_fuel</val> 
                    <val>spent_fuel</val> 
                </feed_commods>
                <feed_commod_prefs> 
                    <vals>1.0</vals> 
                    <vals>1.0</vals> 
                </feed_commod_prefs>
                <feedbuf_size>1000e+3</feedbuf_size>
                <throughput>80e+3</throughput>
                <leftover_commod>separated_waste</leftover_commod>
                <leftoverbuf_size>1000e+3</leftoverbuf_size>
                <streams>
                    <item>
                        <commod>separated_actinides</commod>
                        <info>
                            <buf_size>5e+3</buf_size>
                            <efficiencies>
                                <item>
                                    <comp>94000</comp>
                                    <eff>0.99</eff>
                                </item>
                                <item>
                                    <comp>93000</comp>
                                    <eff>0.99</eff>
                                </item>
                                <item>
                                    <comp>95000</comp>
                                    <eff>0.99</eff>
                                </item>
                                <item>
                                    <comp>96000</comp>
                                    <eff>0.99</eff>
                                </item>
                            </efficiencies>
                        </info>
                    </item>
                </streams>
            </Separations>
        </config>
    </facility>



  <region>
    <name>USA</name>
    <config>
        <NullRegion/>
    </config>
    <institution>
        <initialfacilitylist>
            <!--<entry>
                <prototype>UraniumMine</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>EnrichmentPlant</prototype>
                <number>1</number>
            </entry> -->
            <entry>
                <prototype>Final_Disposal</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>us_inventory</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>NATURE_Reactor</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>SeparationsFacility</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>Mixer_facility</prototype>
                <number>1</number>
            </entry>
        </initialfacilitylist>
        <name>United States Nuclear</name>
        <config>
            <NullInst/>
        </config>
    </institution>

