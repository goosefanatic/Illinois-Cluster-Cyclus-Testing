<!-- Facilities

Source archetype facility
Parameters (* indicates required):
*name: Name, doesn't affect code just for naming convenience
*outcommod: Commodity produced (needs some recipe, otherwise the source creates and provides whatever composition the next facility requests)
outrecipe: Define what the outgoing commodity is made of, default means the recipe will be whatever is requested
inventory_size: How much extra of the commodity the facility can store while not sending to others, default is 1e+299 or basically infinite storage
throughput: how much (in kg) of the commodity the facility outputs per timestep (month), default is 1e+299 or basically infinite throughput or throughput = demand
-->
<!-- Uranium mine is our source-->
    <facility>
        <name>UraniumMine</name>
        <config>
            <Source>
                <outcommod>u_ore</outcommod>
            </Source>
        </config>
    </facility>

<!-- Enrichment plant 

Parameters (* indicates required):
*feed_commod: commodity requested from Source
*feed_recipe: recipe of the commodity requested from Source
*product_commod: commodity produced by the facility
*tails_commod: commodity produced by the facility
max_feed_inventory: maximum kg of feed_commod the facility can store, default is 1e+299 or basically infinite storage
tails_assay: U235 content of tails, default is the maximum of 0.003, can be set as low as 0
initial_feed: kg of feed_commod the facility starts with, default is 0
max_enrich: maximum enrichment of U235 in product_commod, default is 1, can be as low as 0 to basically disable the facility
order_prefs: enable preference ordering for input material (order feed with highest U235 content first)
swu_capacity: SWU capacity of the facility (kgSWU/timestep), default is 1e+299 or basically infinite capacity
-->
    <facility>
        <name>EnrichmentPlant</name>
        <config>
            <Enrichment>
                <feedcommod>u_ore</feedcommod>
                <feedrecipe>nat_u</feedrecipe>
                <product_commod>fresh_uox</product_commod>
                <tails_commod>tails</tails_commod>
                <max_feed_inventory>1000000</max_feed_inventory>
            </Enrichment>
        </config>
    </facility>

<!-- Reactor (this one is more complicated than the rest)
Parameters (* indicates required): (more at https://fuelcycle.org/user/cycamoreagents.html#cycamore-reactor)
*fuel_incommods: input fuel commodity, you can use multiple <val> blocks to have multiple fuel commodities
*fuel_inrecipes: input fuel recipe, can have multiple
fuel_prefs: preference for each type of fresh fuel
*fuel_outcommods: output fuel commodity, can have multiple
*fuel_outrecipes: output fuel recipe, can have multiple
recipe_change_time: number of timesteps the reactor operates before changing fuel recipe
cycle_time: number of timesteps the reactor operates between outages, default is 18
refuel_time: length of refueling outages in timesteps, default is 1
*assem_size: double, kg of fuel in a single assembly, range [1.0,100000.0]
n_assem_core: assemblies in the core, default is 3, range [1,3]
*n_assem_batch: assemblies replaced per refueling
power_cap: int, electricity the reactor generates in MWe (I have no idea how this affects the simulation), default is 0, up to 2000 MWe
n_assem_fresh: int, number of fresh fuel assemblies to keep on standby, default is 0
n_assem_spent: int, number of spent fuel assemblies the reactor can hold onto before stopping operation, default is 1e9 (effectively unlimited)
decom_transmute_all: boolean, if true, all fuel becomes spent when decommissioning, if false, half of the fuel becomes spent
-->
    <facility>
        <name>1178MWe ReactorPlant Unit 1</name>
        <config>
            <Reactor>
                <fuel_incommods>fresh_uox</fuel_incommods>
                <fuel_inrecipes>fresh_uox</fuel_inrecipes>
                <fuel_outcommods>spent_uox</fuel_outcommods>
                <fuel_outrecipes>spent_uox</fuel_outrecipes>
                <cycle_time>18</cycle_time>
                <refuel_time>1</refuel_time>
                <assem_size>33000</assem_size>
                <n_assem_core>3</n_assem_core>
                <n_assem_batch>1</n_assem_batch>
                <power_cap>1178</power_cap>
            </Reactor>
        </config>
    </facility>

<!-- Sink (this one doesn't require much)
Accepts some amount of commodities with some throughput capacity and a total lifetime capacity
Parameters (all optional):
in_commod_prefs: commodities that the sink facility accepts
recipe_name: recipe to use for material requests, default is empty which means accept everything
max_inv_size: total maximum inventory size, default is 1e+299 or basically infinite
capacity: total maximum throughput capacity, default is 1e+299 or basically infinite
-->
    <facility>
    <name>NuclearRepository</name>
    <config>
        <Sink>
        <in_commods>
            <val>spent_uox</val>
            <val>tails</val>
        </in_commods>
        </Sink>
    </config>
    </facility>

<!-- Instututions
Parameters:
*name: name for the institution
lifetime: number of timesteps the institution is active
config: archetype-specific configuration for the institution
initialfacilitylist: list of facilities operating at the start of the simulation under the institution, has the parameters prototype and number
prototype: name of facility defined elsewhere in the input
number: number of that favility at the start of the simulation
-->


<!-- Regions 
Parameters:
name: name of region
config: region archetype  (NullRegion has no inputs so those are empty here)
RegionArchetype: name of region archetype we want to use in a simulation or for a region
-->
    <region>
        <name>USA</name>
        <config>
            <NullRegion/>
        </config>
        <institution>
            <initialfacilitylist>
                <entry>
                    <prototype>UraniumMine</prototype>
                    <number>1</number>
                </entry>
                <entry>
                    <prototype>EnrichmentPlant</prototype>
                    <number>1</number>
                </entry>
                <entry>
                    <prototype>NuclearRepository</prototype>
                    <number>1</number>
                </entry>
            </initialfacilitylist>
            <name>United States Nuclear</name>
            <config>
                <NullInst/>
            </config>
        </institution>

        <institution>
            <initialfacilitylist>
                <entry>
                    <prototype>1178MWe ReactorPlant Unit 1</prototype>
                    <number>1</number>
                </entry>
            </initialfacilitylist>
            <name>Reactor Utility</name>
            <config>
            <NullInst/>
            </config>
        </institution>
    </region>
</simulation>